# systemd unit for the knowledge-graph server. Install it with deploy/install-service.sh,
# which fills in __USER__ and __APP_DIR__ for your machine.
[Unit]
Description=RUBIK Pi knowledge graph (UI + chat API)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=PORT=4173
Environment=HOST=0.0.0.0
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen3.5:2b
ExecStart=/usr/bin/node server/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
